# Copy to .env in this folder and fill in. .env is gitignored.

# Bedrock model, in LiteLLM "provider/model-id" form. The "us." prefix is a
# cross-region inference profile, so model access must be enabled in Bedrock.
MODEL=bedrock/us.amazon.nova-pro-v1:0
AWS_REGION_NAME=us-west-2

# Serper (serper.dev) key for the SerperDevTool internet search.
# Must be upper case: Linux and macOS environment variables are case-sensitive.
SERPER_API_KEY=your-serper-api-key

# Optional: only if you don't use `aws configure` / an AWS profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
